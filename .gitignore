# Deny by default: nothing is tracked unless it is named back below.
# A `!` rule can never reach inside a directory that is still ignored, so
# every kept directory is re-opened, its contents denied again, then the
# files named back with a glob scoped to that directory.
#
# Never named back, deliberately: .env (real credentials) and
# .secrecy-literals (the forbidden-literal list scripts/secrecy-check.sh
# reads). Both stay local; both are covered by the leading `*`.
*

# --- root files -------------------------------------------------------
!.gitignore
!.env.example
!AGENTS.md
!CLAUDE.md
!CONTRIBUTING.md
!LICENSE
!README.md
!pyproject.toml
!requirements.txt
!requirements-dev.txt
!requirements-test.txt
!requirements-diff-cover.txt
!requirements-audit.txt
!requirements-zizmor.txt
!requirements-build.txt
!requirements-speed.txt

# --- CI tooling config ------------------------------------------------
!setup.cfg
!.pylintrc
!pyrightconfig.json
!eslint.config.mjs
!package.json
!package-lock.json

# --- GitHub: templates, workflows, dependabot --------------------------
!.github/
.github/*
!.github/PULL_REQUEST_TEMPLATE.md
!.github/dependabot.yml
!.github/comment-share.json
!.github/ci-thresholds.json
!.github/size-baseline.json
!.github/ISSUE_TEMPLATE/
.github/ISSUE_TEMPLATE/*
!.github/ISSUE_TEMPLATE/*.md
!.github/ISSUE_TEMPLATE/*.yml
!.github/workflows/
.github/workflows/*
!.github/workflows/*.yml
!.github/postgres/
.github/postgres/*
!.github/postgres/16/
.github/postgres/16/*
!.github/postgres/16/Dockerfile
!.github/postgres/17/
.github/postgres/17/*
!.github/postgres/17/Dockerfile

# --- application ------------------------------------------------------
!backend/
backend/*
!backend/*.py
!backend/*.sql

# The client CLI, shipped as the docs-hub-cli wheel. Named back explicitly for
# the same reason as backend/: without it `git add docs_hub_cli/` is refused,
# lint runs `git ls-files '*.py'` over a tree the package is invisible in, and
# the wheel would be built from a directory the repository does not track.
!docs_hub_cli/
docs_hub_cli/*
!docs_hub_cli/*.py

!public/
public/*
!public/*.html
!public/*.js
!public/*.css

!scripts/
scripts/*
!scripts/*.sh
!scripts/pre-push
!scripts/ci/
scripts/ci/*
!scripts/ci/*.py

!tests/
tests/*
!tests/*.py
!tests/*.mjs

!deploy/
deploy/*
!deploy/*.service
!deploy/*.conf

# --- docs -------------------------------------------------------------
!docs/
docs/*
!docs/superpowers/
docs/superpowers/*
!docs/superpowers/plans/
docs/superpowers/plans/*
!docs/superpowers/plans/*.md
!docs/superpowers/plans/*.html
!docs/superpowers/specs/
docs/superpowers/specs/*
!docs/superpowers/specs/*.md
!docs/superpowers/specs/*.html

# --- npm: lint tooling only, never served ------------------------------
# `*` already denies node_modules/, and nothing below names it back.

# --- runtime blob store: the directory ships, its contents never do ----
!store/
store/*
!store/.gitkeep

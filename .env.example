DOCS_HUB_DATABASE_URL_DOCS=postgresql:///docs
DOCS_HUB_DATABASE_URL_AUTH=postgresql:///authdb
DOCS_HUB_SESSION_SECRET=<run: python3 -c "import secrets;print(secrets.token_urlsafe(32))">
DOCS_HUB_API_KEY=<run: python3 -c "import secrets;print(secrets.token_urlsafe(32))">
DOCS_HUB_COOKIE_SECURE=1
DOCS_HUB_STORE_ROOT=/root/docs-hub/store
# machine-specific — copy real values from /root/CLAUDE.md
CF_ZONE_ID=
ORIGIN_IP=
